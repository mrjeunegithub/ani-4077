#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from Jenga import *
useconfig("Kits/NKWindowKit/NKWindowKit.jenga")

with workspace("MonRhiWks", location="."):
       configurations(["Debug", "Release"])
       loadkit("NKGladKit")              # cherche le kit par son nom
       loadkit("Kits/NKGladKit")  # ou ce dossier precis

       # La bibliotheque : du code compile, sans main.
       with project("MonRhi"):
              staticlib()
              language("C++")
              cppdialect("C++17")
              location(".")
              files(["src/MonRhi/**.cpp"])
              includedirs(["src"])
              objdir("%{wks.location}/Build/Obj/"
                     "%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
              targetdir("%{wks.location}/Build/Lib/"
                     "%{cfg.buildcfg}-%{cfg.system}")
              usenkwindowkit()
              usenkgladkit()

       with project("MonUtil"):
              staticlib()
              language("C++")
              cppdialect("C++17")
              location(".")
              files(["src/MonUtil/**.cpp"])
              includedirs(["src"])
              objdir("%{wks.location}/Build/Obj/"
                     "%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
              targetdir("%{wks.location}/Build/Lib/"
                     "%{cfg.buildcfg}-%{cfg.system}")
              usenkwindowkit()

       # Le programme qui s'en sert.
       with project("Essai"):
              consoleapp()
              language("C++")
              cppdialect("C++17")
              location(".")
              files(["src/Essai/**.cpp"])
              includedirs(["src"])
              libdirs(["%{wks.location}/Build/Lib/"
                     "%{cfg.buildcfg}-%{cfg.system}"])
              links(["MonRhi", "MonUtil"])
              objdir("%{wks.location}/Build/Obj/"
                     "%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
              targetdir("%{wks.location}/Build/Bin/"
                     "%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
              usenkwindowkit()
              usenkgladkit()