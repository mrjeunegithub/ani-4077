    configurations(['Debug', 'Release']) # Cette ligne définit les configurations de build disponibles pour le workspace: "Debug" et "Release".
    targetoses([TargetOS.WINDOWS, TargetOS.LINUX, TargetOS.MACOS]) # Cette ligne définit les systèmes d'exploitation cibles pour le workspace: Windows, Linux et macOS.
    targetarchs([TargetArch.X86_64]) # Cette ligne définit les architectures cibles pour le workspace: x86_64.
    
